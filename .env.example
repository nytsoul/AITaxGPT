# Copy this file to .env.local and fill in values

# Set to 1 to use in‑browser dummy authentication (development only).
# When 0 or unset, login/register buttons redirect to Google OAuth.
VITE_USE_DUMMY_AUTH=1

# For real Google auth you must register an OAuth client and provide
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Backend configuration
FRONTEND_URL=http://localhost:5173
MONGO_URL=mongodb://localhost:27017
SECRET_KEY=change-me
